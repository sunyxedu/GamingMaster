# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=            # Jev (System-1) — https://docs.typesafe.ai/api
# Astra (System-2) runs through the codex CLI login (~/.codex/auth.json); no key needed here.
# ANTHROPIC_API_KEY=         # optional: only if you use the claude fallback via API instead of the CLI login

# ARC-AGI-3 (tier 1, optional: pip install arc-agi). Cached game files + offline mode.
OPERATION_MODE=offline
ENVIRONMENTS_DIR=/path/to/environment_files
# ARC_API_KEY=                # only needed to download/cache new games (OPERATION_MODE=normal)
