# Optional absolute path to a checksum-pinned JSON manifest. The bundled
# runtime/manifest.json is used when this is omitted.
# JERICHO_GAME_MANIFEST=/absolute/path/to/manifest.json
# Optional positive submitted-command cap (default 1000).
# JERICHO_MAX_STEPS=1000
# Optional observation label (default text; no privileged state is exposed).
# JERICHO_OBSERVATION_MODE=text
