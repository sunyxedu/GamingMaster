# Optional absolute path to a legally obtained IWAD. If omitted, the adaptor
# copies ViZDoom's bundled Freedoom 2 IWAD into runtime/freedoom2.wad.
# VIZDOOM_WAD_PATH=/absolute/path/to/doom2.wad

# Set this when the IWAD filename does not identify its family.
# VIZDOOM_IWAD_FAMILY=doom1

# Optional fixed map override. Otherwise reset(seed) selects the documented map split.
# VIZDOOM_MAP=MAP01

# Optional 1..5 override. Default: train S2/S3, held-out S4; use 5 only as stress evaluation.
# VIZDOOM_SKILL=3

# Optional positive tic ceiling. ViZDoom's classic 60-minute ceiling is the default.
# VIZDOOM_EPISODE_TIMEOUT_TICS=126000

# Production must remain asynchronous for tier 2.
# VIZDOOM_MODE=ASYNC_PLAYER
