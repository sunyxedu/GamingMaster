# No credentials are required. Defaults start an isolated local offline-mode server.
# Keep gameplay and any RCON endpoints on loopback; this adaptor does not enable RCON.
# MC_RUN_DIR=/absolute/path/to/adaptor/runtime
# MC_HOST=127.0.0.1
# MC_PORT=25565
# MC_USERNAME=HarnessBot
# MC_VERSION=1.21.1
# MC_AUTH=offline
# MC_SERVER_JAR=/absolute/path/to/adaptor/runtime/downloads/server-1.21.1.jar
# JAVA_BIN=/absolute/path/to/java21/bin/java
# NODE_BIN=node
# PYTHON_BIN=/absolute/path/to/runs/minecraft/.venv/bin/python
# PYTHON_BIN_FALLBACK=python3
# Benchmark default max_seconds is 3600; short local smoke tests may pass max_seconds to make_game().
