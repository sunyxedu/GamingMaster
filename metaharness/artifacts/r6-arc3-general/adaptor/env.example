# Required: official SDK runs exclusively offline.
OPERATION_MODE=offline
# Set to your existing cache containing the eight exact versions in ADAPTOR.md.
ENVIRONMENTS_DIR=/absolute/path/to/environment_files

# Optional; defaults are writable paths under this adaptor directory.
# MPLCONFIGDIR=/absolute/path/to/adaptor/.cache/matplotlib
# XDG_CACHE_HOME=/absolute/path/to/adaptor/.cache
# MPLBACKEND=Agg
# RECORDINGS_DIR=/absolute/path/to/adaptor/recordings

# No credentials or server endpoint are needed. ARC_API_KEY and ARC_BASE_URL
# may be read by the SDK if inherited, but are unused in enforced OFFLINE mode.
# Leave ONLY_RESET_LEVELS unset: a nonempty override is rejected.
# Environment variables must be exported by the caller; no .env is auto-loaded
# by this adaptor. Do not replace an existing ENVIRONMENTS_DIR with this example.
