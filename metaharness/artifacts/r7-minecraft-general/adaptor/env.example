# No credentials required. Defaults require no environment settings.
# MC_RUN_DIR=/absolute/path/to/adaptor/runtime
# MC_HOST=127.0.0.1
# MC_PORT=25565
# MC_USERNAME=HarnessBot
# MC_VERSION=1.21.1
# MC_SERVER_JAR=/absolute/path/to/verified/server-1.21.1.jar
# JAVA_BIN=/absolute/path/to/java21/bin/java
# NODE_BIN=node
# PYTHON_BIN=<repo>/.venv/bin/python
# Duration is fixed at 300 seconds; MC_EPISODE_SECONDS is intentionally not read.
