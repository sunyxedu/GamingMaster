# All settings are optional; no account or external credentials are required.
# FACTORIO_BINARY=/absolute/path/to/factorio/bin/x64/factorio
# FACTORIO_WRITE_DIR=/absolute/path/to/adaptor/runtime
# Optional local RCON secret; absent = cryptographically generated per episode.
# FACTORIO_RCON_PASSWORD=
# RCON and multiplayer bind only to 127.0.0.1 on automatically allocated ports.
